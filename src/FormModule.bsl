// Восстановление связей документов 1С с пакетами СБИС после удаления дополнительных сведений.
//
// Обработка читает пакеты из СБИС (СБИС.СписокИзменений) и подбирает документ 1С:
//  1) по GUID: идентификатор исходящего пакета, созданного из 1С, сравнивается со ссылкой документа;
//  2) по реквизитам: номер, дата, ИНН контрагента, ИНН организации, сумма.
// Найденное показывается аналитику. Записываются только отмеченные строки и только если у документа
// ещё нет связи. Существующие записи не перезаписываются. Каждая запись попадает в журнал регистрации.
//
// Модуль формы один для объекта расширения и внешней обработки.
// Реквизиты и элементы формы создаются программно.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизиты();
	СоздатьКоманды();
	СоздатьЭлементы();

	ЭтотОбъект["АдресСервера"]          = "online.sbis.ru";
	ЭтотОбъект["ДатаИзмененийС"]        = ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -12);
	ЭтотОбъект["ДатаИзмененийПо"]       = КонецДня(ТекущаяДатаСеанса());
	ЭтотОбъект["ПропускатьТипыПакетов"] = "КоррВх,КоррИсх";
	ЭтотОбъект["ПисатьНаСвязанные"]     = Истина;
	ЭтотОбъект["РазмерСтраницы"]        = 50;
	ЭтотОбъект["МаксимумЗапросов"]      = 20;
	ЭтотОбъект["ВыбранноеНаправление"]  = "Исходящий";
	ЭтотОбъект["ОтборРезультата"]       = ЗначениеОтбораВсе();

	ЗаполнитьТипыДокументов();

	АвтоЗаголовок = Ложь;
	Заголовок = НСтр("ru = 'Восстановление связей документов 1С с пакетами СБИС'");

	ОбновитьБлокВхода(НСтр("ru = 'Вход не выполнен'"), Ложь);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТипыДокументов()

	Настройки = Новый Массив;
	Настройки.Добавить(Новый Структура("Имя, Направление", "РеализацияТоваровУслуг", "Исходящий"));
	Настройки.Добавить(Новый Структура("Имя, Направление", "СчетФактураВыданный", "Исходящий"));
	Настройки.Добавить(Новый Структура("Имя, Направление", "ВозвратТоваровПоставщику", "Исходящий"));
	Настройки.Добавить(Новый Структура("Имя, Направление", "АктВыполненныхРабот", "Исходящий"));
	Настройки.Добавить(Новый Структура("Имя, Направление", "ПриобретениеТоваровУслуг", "Входящий"));
	Настройки.Добавить(Новый Структура("Имя, Направление", "СчетФактураПолученный", "Входящий"));
	Настройки.Добавить(Новый Структура("Имя, Направление", "ПриобретениеУслугПрочихАктивов", "Входящий"));
	Настройки.Добавить(Новый Структура("Имя, Направление", "ВозвратТоваровОтКлиента", "Входящий"));
	Настройки.Добавить(Новый Структура("Имя, Направление", "СверкаВзаиморасчетов2_5_11", "Любое"));

	ТипыДокументов = ЭтотОбъект["ТипыДокументов"];
	Для Каждого Настройка Из Настройки Цикл
		Если Метаданные.Документы.Найти(Настройка.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТипыДокументов.Добавить();
		НоваяСтрока.Использовать = ВидДокументаИспользуется(Настройка.Имя, Настройка.Направление, ЭтотОбъект["ВыбранноеНаправление"]);
		НоваяСтрока.ИмяДокумента = Настройка.Имя;
		НоваяСтрока.Направление  = Настройка.Направление;
	КонецЦикла;

КонецПроцедуры

// Счёт-фактура полученная связывается через документ-основание, напрямую она не подбирается.
&НаКлиентеНаСервереБезКонтекста
Функция ВидДокументаИспользуется(ИмяДокумента, НаправлениеДокумента, ВыбранноеНаправление)

	Возврат ((НаправлениеДокумента = "Любое") ИЛИ (НаправлениеДокумента = ВыбранноеНаправление))
		И (ИмяДокумента <> "СчетФактураПолученный");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеОтбораВсе()

	Возврат НСтр("ru = 'Все'");

КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Войти(Команда)

	ОчиститьСообщения();

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект["Логин"]) ИЛИ НЕ ЗначениеЗаполнено(ЭтотОбъект["Пароль"]) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите логин и пароль СБИС.'"));
		Возврат;
	КонецЕсли;

	ВойтиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьВход(Команда)

	ОчиститьСообщения();

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект["КодПодтверждения"]) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите код подтверждения.'"));
		Возврат;
	КонецЕсли;

	ПодтвердитьВходНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Выйти(Команда)

	ВыйтиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	ОчиститьСообщения();

	Если НЕ ВходВыполнен() ИЛИ НЕ ПериодУказанВерно() Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Чтение пакетов из СБИС и подбор документов...'"));
	ЗагрузитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтмеченные(Команда)

	Количество = КоличествоОтмеченных();
	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет отмеченных строк с документом 1С.'"));
		Возврат;
	КонецЕсли;

	Если НЕ ВходВыполнен() Тогда
		Возврат;
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru = 'Записать связи по отмеченным строкам (%1)? Существующие связи не изменятся.'"), Количество);
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаписатьОтмеченныеЗавершение", ЭтотОбъект), Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтмеченныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Запись связей...'"));
	ЗаписатьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьНадежные(Команда)

	Для Каждого ТекСтрока Из ЭтотОбъект["Строки"] Цикл
		ТекСтрока.Пометка = ТекСтрока.Надежно И ЗначениеЗаполнено(ТекСтрока.Документ1С);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	Для Каждого ТекСтрока Из ЭтотОбъект["Строки"] Цикл
		ТекСтрока.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ВыбранноеНаправлениеПриИзменении(Элемент)

	ВыбранноеНаправление = ЭтотОбъект["ВыбранноеНаправление"];

	Для Каждого ТекНастройка Из ЭтотОбъект["ТипыДокументов"] Цикл
		ТекНастройка.Использовать = ВидДокументаИспользуется(ТекНастройка.ИмяДокумента, ТекНастройка.Направление, ВыбранноеНаправление);
	КонецЦикла;

	Элементы["ПодсказкаВходящие"].Видимость = (ВыбранноеНаправление = "Входящий");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНастройкиПриИзменении(Элемент)

	Элементы["ГруппаДополнительно"].Видимость = ЭтотОбъект["ПоказатьНастройки"];

КонецПроцедуры

&НаКлиенте
Процедура ОтборРезультатаПриИзменении(Элемент)

	ЗначениеОтбора = ЭтотОбъект["ОтборРезультата"];

	Если НЕ ЗначениеЗаполнено(ЗначениеОтбора) ИЛИ (ЗначениеОтбора = ЗначениеОтбораВсе()) Тогда
		Элементы["Строки"].ОтборСтрок = Неопределено;
	Иначе
		Элементы["Строки"].ОтборСтрок = Новый ФиксированнаяСтруктура("Результат", ЗначениеОтбора);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтрокиДокумент1СНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ТекущиеДанные = Элементы["Строки"].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Кандидаты) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ПараметрыВыбора = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор());
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ВыборКандидатаЗавершение", ЭтотОбъект, ПараметрыВыбора),
		СписокКандидатов(ТекущиеДанные.Кандидаты), Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ВыборКандидатаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекСтрока = ЭтотОбъект["Строки"].НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
	ТекСтрока.Документ1С = ВыбранныйЭлемент.Значение;
	ТекСтрока.Пометка    = Истина;
	ТекСтрока.Способ     = НСтр("ru = 'Выбран вручную'");

КонецПроцедуры

&НаКлиенте
Процедура СтрокиДокумент1СПриИзменении(Элемент)

	ТекущиеДанные = Элементы["Строки"].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные.Пометка = ЗначениеЗаполнено(ТекущиеДанные.Документ1С);
	ТекущиеДанные.Способ  = НСтр("ru = 'Выбран вручную'");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКлиента

&НаКлиенте
Функция ВходВыполнен()

	Если ЗначениеЗаполнено(ЭтотОбъект["СессияСБИС"]) Тогда
		Возврат Истина;
	КонецЕсли;

	ПоказатьПредупреждение(, НСтр("ru = 'Сначала выполните вход в СБИС.'"));
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция ПериодУказанВерно()

	ДатаС  = ЭтотОбъект["ДатаИзмененийС"];
	ДатаПо = ЭтотОбъект["ДатаИзмененийПо"];

	Если НЕ ЗначениеЗаполнено(ДатаС) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите начало периода изменений в СБИС.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаПо) И (ДатаС > ДатаПо) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Начало периода изменений позже его окончания.'"));
		Возврат Ложь;
	КонецЕсли;

	Если (ЭтотОбъект["РазмерСтраницы"] < 1) ИЛИ (ЭтотОбъект["РазмерСтраницы"] > 100) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Пакетов за запрос: укажите значение от 1 до 100.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция КоличествоОтмеченных()

	Количество = 0;
	Для Каждого ТекСтрока Из ЭтотОбъект["Строки"] Цикл
		Если ТекСтрока.Пометка И ЗначениеЗаполнено(ТекСтрока.Документ1С) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

&НаСервереБезКонтекста
Функция СписокКандидатов(Знач Кандидаты)

	Список = Новый СписокЗначений;
	Для Каждого Ссылка Из ЗначениеИзСтрокиВнутр(Кандидаты) Цикл
		Список.Добавить(Ссылка, Строка(Ссылка));
	КонецЦикла;

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ЗагрузкаИСопоставление

&НаСервере
Процедура ЗагрузитьНаСервере()

	Подключение = ОткрытьПодключение();
	Пакеты = ПрочитатьПакеты(Подключение);

	ТаблицаСтрок = Новый Массив;
	Для Каждого Пакет Из Пакеты Цикл
		ТаблицаСтрок.Добавить(НовоеОписаниеСтроки(Пакет.Значение));
	КонецЦикла;

	НайтиПоGUID(ТаблицаСтрок);
	НайтиПоРеквизитам(ТаблицаСтрок);
	УчестьСуществующиеСвязи(ТаблицаСтрок);
	СнятьОтметкиПовторяющихсяДокументов(ТаблицаСтрок);

	ВывестиСтроки(ТаблицаСтрок);

КонецПроцедуры

&НаСервере
Функция ПрочитатьПакеты(Подключение)

	ПропускатьТипы = Новый Соответствие;
	Для Каждого ТипПакета Из СтрРазделить(ЭтотОбъект["ПропускатьТипыПакетов"], ",", Ложь) Цикл
		ПропускатьТипы.Вставить(СокрЛП(ТипПакета), Истина);
	КонецЦикла;

	ДатаПо         = ЭтотОбъект["ДатаИзмененийПо"];
	ДатаДокументаС = ЭтотОбъект["ДатаДокументовС"];
	ДатаДокументаПо = ЭтотОбъект["ДатаДокументовПо"];

	Пакеты = Новый Соответствие;
	ПоследнееСобытие = "";
	МаксимумЗапросов = ЭтотОбъект["МаксимумЗапросов"];
	ЭтотОбъект["ПродолжениеЗагрузки"] = "";

	Для НомерСтраницы = 1 По 10000 Цикл

		Навигация = Новый Структура("РазмерСтраницы", Формат(ЭтотОбъект["РазмерСтраницы"], "ЧГ=0"));
		Фильтр = Новый Структура("ПолныйСертификатЭП, Навигация", "Нет", Навигация);
		Если ЗначениеЗаполнено(ПоследнееСобытие) Тогда
			Фильтр.Вставить("ИдентификаторСобытия", ПоследнееСобытие);
		Иначе
			Фильтр.Вставить("ДатаВремяС", Формат(ЭтотОбъект["ДатаИзмененийС"], "ДФ='дд.ММ.гггг ЧЧ.мм.сс'"));
		КонецЕсли;

		Ответ = ВызватьМетод(Подключение, "/service/?srv=1", "СБИС.СписокИзменений", Новый Структура("Фильтр", Фильтр));
		ДокументыСБИС = Ответ.Получить("Документ");
		Если ДокументыСБИС = Неопределено ИЛИ ДокументыСБИС.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		Для Каждого Документ Из ДокументыСБИС Цикл

			// Пакет, удалённый в СБИС, связывать нельзя, а ранее прочитанное состояние надо забыть.
			Если Документ.Получить("Удален") = "Да" Тогда
				Пакеты.Удалить(Документ.Получить("Идентификатор"));
				Продолжить;
			КонецЕсли;

			Если Строка(Документ.Получить("Направление")) <> ЭтотОбъект["ВыбранноеНаправление"] Тогда
				Продолжить;
			КонецЕсли;

			Если ПропускатьТипы.Получить(Строка(Документ.Получить("Тип"))) = Истина Тогда
				Продолжить;
			КонецЕсли;

			ДатаПакета = ДатаИзСтроки(Документ.Получить("Дата"));
			Если (ЗначениеЗаполнено(ДатаДокументаС) И ДатаПакета < НачалоДня(ДатаДокументаС))
				ИЛИ (ЗначениеЗаполнено(ДатаДокументаПо) И ДатаПакета > КонецДня(ДатаДокументаПо)) Тогда
				Продолжить;
			КонецЕсли;

			// Последнее изменение пакета заменяет предыдущее: остаётся актуальное состояние.
			Пакеты.Вставить(Документ.Получить("Идентификатор"), Документ);

		КонецЦикла;

		События = ДокументыСБИС[ДокументыСБИС.Количество() - 1].Получить("Событие");
		Если События = Неопределено ИЛИ События.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		Событие = События[События.Количество() - 1];
		НовоеСобытие = Событие.Получить("Идентификатор");
		Навигация = Ответ.Получить("Навигация");
		ЕстьЕще = (Навигация <> Неопределено) И (Навигация.Получить("ЕстьЕще") = "Да");

		Если НЕ ЕстьЕще
			ИЛИ НовоеСобытие = ПоследнееСобытие
			ИЛИ (ЗначениеЗаполнено(ДатаПо) И ДатаВремяИзСтроки(Событие.Получить("ДатаВремя")) > КонецДня(ДатаПо)) Тогда
			Прервать;
		КонецЕсли;

		Если (МаксимумЗапросов > 0) И (НомерСтраницы >= МаксимумЗапросов) Тогда
			ЗапомнитьПродолжение(ДатаВремяИзСтроки(Событие.Получить("ДатаВремя")));
			Прервать;
		КонецЕсли;

		ПоследнееСобытие = НовоеСобытие;

	КонецЦикла;

	Возврат Пакеты;

КонецФункции

// Загрузка порциями: следующая порция начнётся с дня последнего прочитанного события.
&НаСервере
Процедура ЗапомнитьПродолжение(ДатаСобытия)

	НовоеНачало = НачалоДня(ДатаСобытия);

	Если НовоеНачало <= НачалоДня(ЭтотОбъект["ДатаИзмененийС"]) Тогда
		ЭтотОбъект["ПродолжениеЗагрузки"] = НСтр("ru = 'Порция не вышла за пределы одного дня: увеличьте размер порции.'");
		Возврат;
	КонецЕсли;

	ЭтотОбъект["ДатаИзмененийС"] = НовоеНачало;
	ЭтотОбъект["ПродолжениеЗагрузки"] = СтрШаблон(
		НСтр("ru = 'Загружена часть периода. Запишите результат и нажмите загрузку снова: продолжение с %1.'"),
		Формат(НовоеНачало, "ДЛФ=D"));

КонецПроцедуры

&НаСервере
Функция НовоеОписаниеСтроки(Пакет)

	Контрагент  = ДанныеСтороны(Пакет.Получить("Контрагент"));
	Организация = ДанныеСтороны(Пакет.Получить("НашаОрганизация"));
	СостояниеПакета = Пакет.Получить("Состояние");

	Описание = Новый Структура;
	Описание.Вставить("Пометка", Ложь);
	Описание.Вставить("Надежно", Ложь);
	Описание.Вставить("Результат", НСтр("ru = 'Не найден'"));
	Описание.Вставить("Способ", "");
	Описание.Вставить("Замечание", "");
	Описание.Вставить("Документ1С", Неопределено);
	Описание.Вставить("Кандидаты", "");
	Описание.Вставить("Направление", Строка(Пакет.Получить("Направление")));
	Описание.Вставить("ТипПакета", Строка(Пакет.Получить("Тип")));
	Описание.Вставить("Номер", Строка(Пакет.Получить("Номер")));
	Описание.Вставить("Дата", ДатаИзСтроки(Пакет.Получить("Дата")));
	Описание.Вставить("Сумма", ЧислоИзСтроки(Пакет.Получить("Сумма")));
	Описание.Вставить("ИНН", Контрагент.ИНН);
	Описание.Вставить("Контрагент", Контрагент.Название);
	Описание.Вставить("ИННОрганизации", Организация.ИНН);
	Описание.Вставить("Состояние", ?(СостояниеПакета = Неопределено, "", Строка(СостояниеПакета.Получить("Название"))));
	Описание.Вставить("Название", Строка(Пакет.Получить("Название")));
	Описание.Вставить("ИдПакета", Строка(Пакет.Получить("Идентификатор")));
	Описание.Вставить("Скрыть", Ложь);

	Возврат Описание;

КонецФункции

&НаСервере
Функция ДанныеСтороны(Сторона)

	Результат = Новый Структура("ИНН, Название", "", "");
	Если Сторона = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ИмяСведений Из СтрРазделить("СвЮЛ,СвФЛ", ",") Цикл
		Сведения = Сторона.Получить(ИмяСведений);
		Если Сведения <> Неопределено Тогда
			Результат.ИНН      = Строка(Сведения.Получить("ИНН"));
			Результат.Название = Строка(Сведения.Получить("Название"));
			Если НЕ ЗначениеЗаполнено(Результат.Название) Тогда
				Результат.Название = СокрЛП(Строка(Сведения.Получить("Фамилия")) + " " + Строка(Сведения.Получить("Имя")));
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ИменаДокументов(Направление)

	Имена = Новый Массив;
	Для Каждого Настройка Из ЭтотОбъект["ТипыДокументов"] Цикл
		Если Настройка.Использовать
			И ((Настройка.Направление = "Любое") ИЛИ (Настройка.Направление = Направление))
			И Метаданные.Документы.Найти(СокрЛП(Настройка.ИмяДокумента)) <> Неопределено Тогда
			Имена.Добавить(СокрЛП(Настройка.ИмяДокумента));
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Исходящие пакеты, созданные из 1С, имеют идентификатор вида UUID v1, совпадающий с GUID документа.
&НаСервере
Процедура НайтиПоGUID(ТаблицаСтрок)

	Для Каждого Направление Из СтрРазделить("Исходящий,Входящий", ",") Цикл

		ИдСтрок = Новый Соответствие;
		Для Каждого Описание Из ТаблицаСтрок Цикл
			Если Описание.Направление = Направление И Сред(Описание.ИдПакета, 15, 1) = "1" Тогда
				ИдСтрок.Вставить(НРег(Описание.ИдПакета), Описание);
			КонецЕсли;
		КонецЦикла;

		Если ИдСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ИмяДокумента Из ИменаДокументов(Направление) Цикл

			Ссылки = Новый Массив;
			Для Каждого ЭлементИд Из ИдСтрок Цикл
				Попытка
					Ссылки.Добавить(Документы[ИмяДокумента].ПолучитьСсылку(Новый УникальныйИдентификатор(ЭлементИд.Ключ)));
				Исключение
					Продолжить;
				КонецПопытки;
			КонецЦикла;

			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ДокументыУчета.Ссылка КАК Ссылка,
			|	ДокументыУчета.ПометкаУдаления КАК ПометкаУдаления
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК ДокументыУчета
			|ГДЕ
			|	ДокументыУчета.Ссылка В(&Ссылки)";
			Запрос.УстановитьПараметр("Ссылки", Ссылки);

			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Описание = ИдСтрок.Получить(НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор())));
				Если Описание <> Неопределено Тогда
					Описание.Документ1С = Выборка.Ссылка;
					Описание.Способ     = "GUID";
					Если Выборка.ПометкаУдаления Тогда
						Описание.Результат = НСтр("ru = 'Проверить'");
						Описание.Замечание = НСтр("ru = 'Документ помечен на удаление'");
					Иначе
						Описание.Результат = НСтр("ru = 'Найден'");
						Описание.Пометка   = Истина;
						Описание.Надежно   = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НайтиПоРеквизитам(ТаблицаСтрок)

	Для Каждого Направление Из СтрРазделить("Исходящий,Входящий", ",") Цикл

		Строки = Новый Массив;
		МинДата = Неопределено;
		МаксДата = Неопределено;
		Для Каждого Описание Из ТаблицаСтрок Цикл
			Если Описание.Направление <> Направление ИЛИ Описание.Документ1С <> Неопределено
				ИЛИ НЕ ЗначениеЗаполнено(Описание.Номер) ИЛИ НЕ ЗначениеЗаполнено(Описание.Дата) Тогда
				Продолжить;
			КонецЕсли;
			Строки.Добавить(Описание);
			МинДата = ?(МинДата = Неопределено, Описание.Дата, Мин(МинДата, Описание.Дата));
			МаксДата = ?(МаксДата = Неопределено, Описание.Дата, Макс(МаксДата, Описание.Дата));
		КонецЦикла;

		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Входящий документ могут зарегистрировать позже его даты, поэтому период шире.
		Индекс = ИндексДокументов(Направление, МинДата - 31 * 86400, КонецДня(МаксДата) + 62 * 86400);

		Для Каждого Описание Из Строки Цикл
			ПодобратьПоИндексу(Описание, Индекс);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ИндексДокументов(Направление, НачалоПериода, КонецПериода)

	Индекс = Новый Соответствие;

	Для Каждого ИмяДокумента Из ИменаДокументов(Направление) Цикл

		МетаДокумент = Метаданные.Документы[ИмяДокумента];
		Если МетаДокумент.ДлинаНомера = 0 Тогда
			Продолжить;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументыУчета.Ссылка КАК Ссылка,
		|	ДокументыУчета.Номер КАК Номер,
		|	ДокументыУчета.Дата КАК Дата,
		|	" + ПолеИлиПустое(МетаДокумент, "НомерВходящегоДокумента", "НомерВходящегоДокумента", """""") + " КАК НомерВходящий,
		|	" + ПолеИлиПустое(МетаДокумент, "ДатаВходящегоДокумента", "ДатаВходящегоДокумента", "ДАТАВРЕМЯ(1, 1, 1)") + " КАК ДатаВходящая,
		|	" + ПолеИлиПустое(МетаДокумент, "Контрагент", "Контрагент.ИНН", """""") + " КАК ИНН,
		|	" + ПолеИлиПустое(МетаДокумент, "Организация", "Организация.ИНН", """""") + " КАК ИННОрганизации,
		|	" + ПолеИлиПустое(МетаДокумент, "СуммаДокумента", "СуммаДокумента", "0") + " КАК Сумма
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК ДокументыУчета
		|ГДЕ
		|	ДокументыУчета.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ ДокументыУчета.ПометкаУдаления";
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Документ %1 пропущен: %2'"), ИмяДокумента,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Продолжить;
		КонецПопытки;

		Пока Выборка.Следующий() Цикл

			ДанныеДокумента = Новый Структура("Ссылка, ИНН, ИННОрганизации, Сумма, ЭтоСчетФактура",
				Выборка.Ссылка, СокрЛП(Выборка.ИНН), СокрЛП(Выборка.ИННОрганизации), Выборка.Сумма,
				СтрНайти(ИмяДокумента, "СчетФактура") > 0);

			Если ЗначениеЗаполнено(Выборка.НомерВходящий) И ЗначениеЗаполнено(Выборка.ДатаВходящая) Тогда
				ДобавитьВИндекс(Индекс, Выборка.НомерВходящий, Выборка.ДатаВходящая, ДанныеДокумента);
			Иначе
				ДобавитьВИндекс(Индекс, Выборка.Номер, Выборка.Дата, ДанныеДокумента);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат Индекс;

КонецФункции

&НаСервере
Функция ПолеИлиПустое(МетаДокумент, ИмяРеквизита, ПутьКПолю, ПустоеЗначение)

	Если МетаДокумент.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;

	Возврат "ЕСТЬNULL(ДокументыУчета." + ПутьКПолю + ", " + ПустоеЗначение + ")";

КонецФункции

&НаСервере
Процедура ДобавитьВИндекс(Индекс, Номер, Дата, ДанныеДокумента)

	ДобавитьЗначениеКлюча(Индекс, КлючПолногоНомера(Номер, Дата), ДанныеДокумента);

	КлючЧисла = КлючЧисловойЧасти(Номер, Дата);
	Если ЗначениеЗаполнено(КлючЧисла) Тогда
		ДобавитьЗначениеКлюча(Индекс, КлючЧисла, ДанныеДокумента);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЗначениеКлюча(Индекс, Ключ, ДанныеДокумента)

	Значения = Индекс.Получить(Ключ);
	Если Значения = Неопределено Тогда
		Значения = Новый Массив;
		Индекс.Вставить(Ключ, Значения);
	КонецЕсли;
	Значения.Добавить(ДанныеДокумента);

КонецПроцедуры

&НаСервере
Функция КлючПолногоНомера(Номер, Дата)

	Возврат "П|" + ВРег(СтрЗаменить(СокрЛП(Номер), " ", "")) + "|" + Формат(Дата, "ДФ=ггггММдд");

КонецФункции

// Номер в СБИС обычно печатный (АБ-1039), а в 1С с префиксом и нулями (АБ00-001039),
// поэтому дополнительно сравнивается последняя группа цифр.
&НаСервере
Функция КлючЧисловойЧасти(Номер, Дата)

	Текст = СокрЛП(Номер);
	Цифры = "";
	Для Индекс = -СтрДлина(Текст) По -1 Цикл
		Символ = Сред(Текст, -Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Символ + Цифры;
	КонецЦикла;

	Если Цифры = "" Тогда
		Возврат "";
	КонецЕсли;

	Возврат "Ч|" + Формат(Число(Цифры), "ЧН=0; ЧГ=0") + "|" + Формат(Дата, "ДФ=ггггММдд");

КонецФункции

&НаСервере
Процедура ПодобратьПоИндексу(Описание, Индекс)

	Кандидаты = Индекс.Получить(КлючПолногоНомера(Описание.Номер, Описание.Дата));
	Если Кандидаты = Неопределено Тогда
		Кандидаты = Индекс.Получить(КлючЧисловойЧасти(Описание.Номер, Описание.Дата));
	КонецЕсли;
	Если Кандидаты = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Подходящие = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ЗначенияСовпадаютИлиПусты(Кандидат.ИНН, Описание.ИНН)
			И ЗначенияСовпадаютИлиПусты(Кандидат.ИННОрганизации, Описание.ИННОрганизации) Тогда
			Подходящие.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Подходящие = ОсновныеДокументы(Подходящие);
	Если Подходящие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Описание.Способ = НСтр("ru = 'Номер, дата, ИНН'");

	Если Подходящие.Количество() > 1 Тогда
		Ссылки = Новый Массив;
		Для Каждого Кандидат Из Подходящие Цикл
			Ссылки.Добавить(Кандидат.Ссылка);
		КонецЦикла;
		Описание.Кандидаты = ЗначениеВСтрокуВнутр(Ссылки);
		Описание.Результат = НСтр("ru = 'Несколько кандидатов'");
		Описание.Замечание = НСтр("ru = 'Выберите документ в колонке «Документ 1С»'");
		Возврат;
	КонецЕсли;

	Кандидат = Подходящие[0];
	Описание.Документ1С = Кандидат.Ссылка;

	Если Описание.Сумма <> 0 И Кандидат.Сумма <> 0 И Окр(Описание.Сумма - Кандидат.Сумма, 2) <> 0 Тогда
		Описание.Результат = НСтр("ru = 'Проверить'");
		Описание.Замечание = СтрШаблон(НСтр("ru = 'Сумма в 1С: %1'"), Формат(Кандидат.Сумма, "ЧДЦ=2; ЧГ=0"));
		Возврат;
	КонецЕсли;

	Описание.Результат = НСтр("ru = 'Найден'");
	Описание.Пометка   = Истина;
	Описание.Надежно   = Истина;

КонецПроцедуры

&НаСервере
Функция ЗначенияСовпадаютИлиПусты(Значение1, Значение2)

	Возврат НЕ ЗначениеЗаполнено(Значение1) ИЛИ НЕ ЗначениеЗаполнено(Значение2) ИЛИ Значение1 = Значение2;

КонецФункции

// Счёт-фактура и документ отгрузки с одним номером входят в один пакет. Основным считается документ отгрузки.
&НаСервере
Функция ОсновныеДокументы(Кандидаты)

	Основные = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если НЕ Кандидат.ЭтоСчетФактура Тогда
			Основные.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Основные.Количество() > 0, Основные, Кандидаты);

КонецФункции

&НаСервере
Процедура УчестьСуществующиеСвязи(ТаблицаСтрок)

	Связи = СуществующиеСвязи();

	Для Каждого Описание Из ТаблицаСтрок Цикл

		ДокументПакета = Связи.ПоПакету.Получить(НРег(Описание.ИдПакета));
		Если ДокументПакета <> Неопределено Тогда
			Описание.Документ1С = ДокументПакета;
			Описание.Кандидаты  = "";
			Описание.Результат  = НСтр("ru = 'Уже связан'");
			Описание.Пометка    = Ложь;
			Описание.Надежно    = Ложь;
			Описание.Скрыть     = Истина;
			Продолжить;
		КонецЕсли;

		Если Описание.Документ1С = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ТекущийПакет = Связи.ПоДокументу.Получить(Описание.Документ1С);
		Если ТекущийПакет <> Неопределено Тогда
			Описание.Результат = НСтр("ru = 'Связан с другим пакетом'");
			Описание.Замечание = ТекущийПакет;
			Описание.Пометка   = Ложь;
			Описание.Надежно   = Ложь;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СуществующиеСвязи()

	Результат = Новый Структура("ПоПакету, ПоДокументу", Новый Соответствие, Новый Соответствие);

	СвойствоИд = НайтиСвойство("ДокументСБИС_Ид");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДопСведения.Объект КАК Объект,
	|	ДопСведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДопСведения
	|ГДЕ
	|	ДопСведения.Свойство = &Свойство";
	Запрос.УстановитьПараметр("Свойство", СвойствоИд);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдПакета = Лев(Строка(Выборка.Значение), 36);
		Результат.ПоПакету.Вставить(НРег(ИдПакета), Выборка.Объект);
		Результат.ПоДокументу.Вставить(Выборка.Объект, ИдПакета);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Один документ не может быть связан с несколькими пакетами: такие строки разбирает аналитик.
&НаСервере
Процедура СнятьОтметкиПовторяющихсяДокументов(ТаблицаСтрок)

	Счетчик = Новый Соответствие;
	Для Каждого Описание Из ТаблицаСтрок Цикл
		Если Описание.Пометка Тогда
			Количество = Счетчик.Получить(Описание.Документ1С);
			Счетчик.Вставить(Описание.Документ1С, ?(Количество = Неопределено, 1, Количество + 1));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Описание Из ТаблицаСтрок Цикл
		Если Описание.Пометка И Счетчик.Получить(Описание.Документ1С) > 1 Тогда
			Описание.Пометка   = Ложь;
			Описание.Надежно   = Ложь;
			Описание.Результат = НСтр("ru = 'Проверить'");
			Описание.Замечание = НСтр("ru = 'Этот документ подобран к нескольким пакетам'");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиСтроки(ТаблицаСтрок)

	Строки = ЭтотОбъект["Строки"];
	Строки.Очистить();

	ЭтотОбъект["ОтборРезультата"] = ЗначениеОтбораВсе();
	Элементы["Строки"].ОтборСтрок = Неопределено;

	Итоги = Новый Соответствие;
	Показывать = ЭтотОбъект["ПоказыватьСвязанные"];

	Для Каждого Описание Из ТаблицаСтрок Цикл

		Количество = Итоги.Получить(Описание.Результат);
		Итоги.Вставить(Описание.Результат, ?(Количество = Неопределено, 1, Количество + 1));

		Если Описание.Скрыть И НЕ Показывать Тогда
			Продолжить;
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(Строки.Добавить(), Описание);

	КонецЦикла;

	ТаблицаРезультата = РеквизитФормыВЗначение("Строки");
	ТаблицаРезультата.Сортировать("Результат Возр, Дата Возр");
	ЗначениеВРеквизитФормы(ТаблицаРезультата, "Строки");

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Пакетов: %1'"), ТаблицаСтрок.Количество()));
	Для Каждого Итог Из Итоги Цикл
		Части.Добавить(Итог.Ключ + ": " + Итог.Значение);
	КонецЦикла;

	Если ЗначениеЗаполнено(ЭтотОбъект["ПродолжениеЗагрузки"]) Тогда
		Части.Добавить(ЭтотОбъект["ПродолжениеЗагрузки"]);
	КонецЕсли;

	Элементы["Итог"].Заголовок = СтрСоединить(Части, "; ");

КонецПроцедуры

#КонецОбласти

#Область Запись

&НаСервере
Процедура ЗаписатьНаСервере()

	Свойства = Новый Структура;
	Свойства.Вставить("Ид", НайтиСвойство("ДокументСБИС_Ид"));
	Свойства.Вставить("ИдВложения", НайтиСвойство("ДокументСБИС_ИдВложения"));
	Свойства.Вставить("Статус", НайтиСвойство("ДокументСБИС_Статус"));

	Подключение = ОткрытьПодключение();

	Записано = 0;
	Ошибок   = 0;

	Для Каждого ТекСтрока Из ЭтотОбъект["Строки"] Цикл

		Если НЕ ТекСтрока.Пометка ИЛИ НЕ ЗначениеЗаполнено(ТекСтрока.Документ1С) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ЗаписатьСвязьСтроки(ТекСтрока, Свойства, Подключение);
			Записано = Записано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			ТекСтрока.Результат = НСтр("ru = 'Ошибка записи'");
			ТекСтрока.Замечание = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ТекСтрока.Документ1С,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Элементы["Итог"].Заголовок = СтрШаблон(НСтр("ru = 'Записано строк: %1, ошибок: %2. Статус записан из СБИС на момент загрузки, дальнейшие изменения подтянет штатный обмен.'"),
		Записано, Ошибок);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьСвязьСтроки(ТекСтрока, Свойства, Подключение)

	ИдВложения = ИдентификаторОсновногоВложения(Подключение, ТекСтрока.ИдПакета);

	Документы1С = Новый Массив;
	Документы1С.Добавить(ТекСтрока.Документ1С);
	Если ЭтотОбъект["ПисатьНаСвязанные"] Тогда
		Для Каждого Связанный Из СвязанныеДокументы(ТекСтрока.Документ1С) Цикл
			Если Документы1С.Найти(Связанный) = Неопределено Тогда
				Документы1С.Добавить(Связанный);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Замечания = Новый Массив;

	НачатьТранзакцию();
	Попытка
		Для Каждого Документ1С Из Документы1С Цикл

			Если ЕстьЗапись(Документ1С, Свойства.Ид) Тогда
				Замечания.Добавить(СтрШаблон(НСтр("ru = 'Пропущен, уже есть связь: %1'"), Строка(Документ1С)));
				Продолжить;
			КонецЕсли;

			ЗаписатьЗначение(Документ1С, Свойства.Ид, ТекСтрока.ИдПакета);
			Если ЗначениеЗаполнено(ИдВложения) Тогда
				ЗаписатьЗначение(Документ1С, Свойства.ИдВложения, ИдВложения);
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекСтрока.Состояние) Тогда
				ЗаписатьЗначение(Документ1С, Свойства.Статус, ТекСтрока.Состояние);
			КонецЕсли;

			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , Документ1С,
				СтрШаблон("Пакет %1, вложение %2, статус %3, способ: %4", ТекСтрока.ИдПакета, ИдВложения, ТекСтрока.Состояние, ТекСтрока.Способ));

		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(ИдВложения) Тогда
		Замечания.Добавить(НСтр("ru = 'Не определено основное вложение пакета'"));
	КонецЕсли;

	ТекСтрока.Пометка   = Ложь;
	ТекСтрока.Результат = НСтр("ru = 'Записан'");
	ТекСтрока.Замечание = СтрСоединить(Замечания, "; ");

КонецПроцедуры

&НаСервере
Функция ИдентификаторОсновногоВложения(Подключение, ИдПакета)

	Попытка
		Ответ = ВызватьМетод(Подключение, "/service/?srv=1", "СБИС.ПрочитатьДокумент",
			Новый Структура("Документ", Новый Структура("Идентификатор", ИдПакета)));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "";
	КонецПопытки;

	Вложения = Ответ.Получить("Вложение");
	Если Вложения = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Вложение Из Вложения Цикл
		Если Вложение.Получить("Служебный") = "Нет" И Вложение.Получить("Удален") <> "Да" Тогда
			Возврат Вложение.Получить("Идентификатор");
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Штатный обмен проставляет связь на каждом документе пакета (документ отгрузки и счёт-фактура).
&НаСервере
Функция СвязанныеДокументы(Документ1С)

	Результат = Новый Массив;
	ИмяДокумента = Документ1С.Метаданные().Имя;

	Для Каждого ИмяСчетаФактуры Из СтрРазделить("СчетФактураВыданный,СчетФактураПолученный", ",") Цикл

		МетаСчета = Метаданные.Документы.Найти(ИмяСчетаФактуры);
		Если МетаСчета = Неопределено ИЛИ МетаСчета.ТабличныеЧасти.Найти("ДокументыОснования") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Запрос = Новый Запрос;
		Если ИмяДокумента = ИмяСчетаФактуры Тогда
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДокументыУчета.ДокументОснование КАК Ссылка
			|ИЗ
			|	Документ." + ИмяСчетаФактуры + ".ДокументыОснования КАК ДокументыУчета
			|ГДЕ
			|	ДокументыУчета.Ссылка = &Документ";
		Иначе
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДокументыУчета.Ссылка КАК Ссылка
			|ИЗ
			|	Документ." + ИмяСчетаФактуры + ".ДокументыОснования КАК ДокументыУчета
			|ГДЕ
			|	ДокументыУчета.ДокументОснование = &Документ
			|	И НЕ ДокументыУчета.Ссылка.ПометкаУдаления" + ?(МетаСчета.Реквизиты.Найти("Исправление") = Неопределено, "", "
			|	И НЕ ДокументыУчета.Ссылка.Исправление");
		КонецЕсли;
		Запрос.УстановитьПараметр("Документ", Документ1С);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
				Результат.Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ЕстьЗапись(Документ1С, Свойство)

	НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Документ1С);
	НаборЗаписей.Отбор.Свойство.Установить(Свойство);
	НаборЗаписей.Прочитать();

	Возврат НаборЗаписей.Количество() > 0;

КонецФункции

&НаСервере
Процедура ЗаписатьЗначение(Документ1С, Свойство, Значение)

	НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Документ1С);
	НаборЗаписей.Отбор.Свойство.Установить(Свойство);

	Запись = НаборЗаписей.Добавить();
	Запись.Объект   = Документ1С;
	Запись.Свойство = Свойство;
	Запись.Значение = Значение;

	НаборЗаписей.Записать();

КонецПроцедуры

&НаСервере
Функция НайтиСвойство(ИмяБезПрефикса)

	ПолноеИмя = СокрЛП(ЭтотОбъект["ПрефиксСвойств"]) + ИмяБезПрефикса;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2
	|	СвойстваПлана.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК СвойстваПлана
	|ГДЕ
	|	СвойстваПлана.Наименование = &Имя";
	Запрос.УстановитьПараметр("Имя", ПолноеИмя);

	// Штатная обработка ищет свойство по наименованию. При дублях неизвестно, какое из них она возьмёт.
	Найденные = Запрос.Выполнить().Выгрузить();
	Если Найденные.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Найдено несколько свойств «%1», в том числе, возможно, помеченные на удаление. Оставьте одно и повторите.'"), ПолноеИмя);
	КонецЕсли;

	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0].Ссылка;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдено свойство «%1». Его создаёт штатная обработка СБИС в рабочей базе; в копии базы штатную обработку под рабочим аккаунтом не запускайте.'"), ПолноеИмя);

КонецФункции

&НаСервере
Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'Восстановление связей СБИС'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти

#Область РаботаССБИС

&НаСервере
Функция ОткрытьПодключение(ИдСессии = Неопределено)

	Защищенное = Новый ЗащищенноеСоединениеOpenSSL();
	Соединение = Новый HTTPСоединение(СокрЛП(ЭтотОбъект["АдресСервера"]), 443, , , , 120, Защищенное);

	Сессия = ?(ИдСессии = Неопределено, ЭтотОбъект["СессияСБИС"], ИдСессии);

	Возврат Новый Структура("Соединение, ИдСессии", Соединение, Сессия);

КонецФункции

&НаСервере
Процедура ВойтиНаСервере()

	Параметр = Новый Структура("Логин, Пароль", СокрЛП(ЭтотОбъект["Логин"]), ЭтотОбъект["Пароль"]);
	Подключение = ОткрытьПодключение("");

	Ответ = ВыполнитьМетод(Подключение, "/auth/service/", "СБИС.Аутентифицировать", Новый Структура("Параметр", Параметр));
	Если Ответ.Ошибка = Неопределено Тогда
		ЗавершитьВход(Ответ.Результат);
		Возврат;
	КонецЕсли;

	ДанныеПодтверждения = ДанныеПодтвержденияВхода(Ответ.Ошибка);
	Если ДанныеПодтверждения = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось войти в СБИС: %1'"), ТекстОшибкиСБИС(Ответ.Ошибка));
	КонецЕсли;

	ЭтотОбъект["ИдСессииПодтверждения"] = Строка(ДанныеПодтверждения.Получить("ИдентификаторСессии"));
	ЭтотОбъект["ИдПодтверждения"]       = Строка(ДанныеПодтверждения.Получить("Идентификатор"));

	МетодОтправки = ДанныеПодтверждения.Получить("МетодОтправкиКодаПодтверждения");
	Если ЗначениеЗаполнено(МетодОтправки) Тогда
		ПодключениеКода = ОткрытьПодключение(ЭтотОбъект["ИдСессииПодтверждения"]);
		ВызватьМетод(ПодключениеКода, "/auth/service/", МетодОтправки, Новый Структура("Идентификатор", ЭтотОбъект["ИдПодтверждения"]));
	КонецЕсли;

	ЭтотОбъект["КодПодтверждения"] = "";
	ОбновитьБлокВхода(НСтр("ru = 'Введите код подтверждения и нажмите «Подтвердить».'"), Истина);

КонецПроцедуры

&НаСервере
Функция ДанныеПодтвержденияВхода(Ошибка)

	Если ТипЗнч(Ошибка) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Ошибка.Получить("data");
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДополнительныеДанные = Данные.Получить("addinfo");
	Если ТипЗнч(ДополнительныеДанные) <> Тип("Соответствие")
		ИЛИ НЕ ЗначениеЗаполнено(ДополнительныеДанные.Получить("Идентификатор")) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДополнительныеДанные;

КонецФункции

&НаСервере
Процедура ПодтвердитьВходНаСервере()

	Подключение = ОткрытьПодключение(ЭтотОбъект["ИдСессииПодтверждения"]);
	Параметры_ = Новый Структура("Код, Идентификатор", СокрЛП(ЭтотОбъект["КодПодтверждения"]), ЭтотОбъект["ИдПодтверждения"]);

	Результат = ВызватьМетод(Подключение, "/auth/service/", "СБИС.ПодтвердитьВход", Параметры_);
	ЗавершитьВход(Результат);

КонецПроцедуры

&НаСервере
Процедура ЗавершитьВход(ИдСессии)

	Если НЕ ЗначениеЗаполнено(ИдСессии) Тогда
		ВызватьИсключение НСтр("ru = 'СБИС не вернул идентификатор сессии.'");
	КонецЕсли;

	ЭтотОбъект["СессияСБИС"]            = ИдСессии;
	ЭтотОбъект["Пароль"]                = "";
	ЭтотОбъект["КодПодтверждения"]      = "";
	ЭтотОбъект["ИдСессииПодтверждения"] = "";
	ЭтотОбъект["ИдПодтверждения"]       = "";

	ОбновитьБлокВхода(СтрШаблон(НСтр("ru = 'Вход выполнен: %1'"), СокрЛП(ЭтотОбъект["Логин"])), Ложь);

КонецПроцедуры

&НаСервере
Процедура ВыйтиНаСервере()

	Если ЗначениеЗаполнено(ЭтотОбъект["СессияСБИС"]) Тогда
		Ответ = ВыполнитьМетод(ОткрытьПодключение(), "/auth/service/", "СБИС.Выход", Новый Структура);
		Если Ответ.Ошибка <> Неопределено Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
				ТекстОшибкиСБИС(Ответ.Ошибка));
		КонецЕсли;
	КонецЕсли;

	ЭтотОбъект["СессияСБИС"] = "";
	ОбновитьБлокВхода(НСтр("ru = 'Вход не выполнен'"), Ложь);

КонецПроцедуры

&НаСервере
Процедура ОбновитьБлокВхода(ТекстСостояния, ОжидаетсяКод)

	ЕстьСессия = ЗначениеЗаполнено(ЭтотОбъект["СессияСБИС"]);

	Элементы["СостояниеВхода"].Заголовок = ТекстСостояния;

	Элементы["Логин"].Видимость                 = НЕ ЕстьСессия;
	Элементы["Пароль"].Видимость                = НЕ ЕстьСессия;
	Элементы["КодПодтверждения"].Видимость      = ОжидаетсяКод;
	Элементы["КнопкаВойти"].Видимость           = НЕ ЕстьСессия;
	Элементы["КнопкаПодтвердитьВход"].Видимость = ОжидаетсяКод;
	Элементы["КнопкаВыйти"].Видимость           = ЕстьСессия;

	Элементы["ГруппаЗагрузка"].Доступность = ЕстьСессия;
	Элементы["ГруппаПроверка"].Доступность = ЕстьСессия;
	Элементы["Строки"].Доступность         = ЕстьСессия;

КонецПроцедуры

&НаСервере
Функция ВызватьМетод(Подключение, АдресРесурса, ИмяМетода, ПараметрыМетода)

	Ответ = ВыполнитьМетод(Подключение, АдресРесурса, ИмяМетода, ПараметрыМетода);
	Если Ответ.Ошибка <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ошибка СБИС (%1): %2'"), ИмяМетода, ТекстОшибкиСБИС(Ответ.Ошибка));
	КонецЕсли;

	Возврат Ответ.Результат;

КонецФункции

&НаСервере
Функция ВыполнитьМетод(Подключение, АдресРесурса, ИмяМетода, ПараметрыМетода)

	ЗапросСБИС = Новый Структура;
	ЗапросСБИС.Вставить("jsonrpc", "2.0");
	ЗапросСБИС.Вставить("method", ИмяМетода);
	ЗапросСБИС.Вставить("params", ПараметрыМетода);
	ЗапросСБИС.Вставить("protocol", 2);
	ЗапросСБИС.Вставить("id", 0);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ЗапросСБИС);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json-rpc;charset=utf-8");
	Заголовки.Вставить("Accept", "application/json-rpc");
	Если ЗначениеЗаполнено(Подключение.ИдСессии) Тогда
		Заголовки.Вставить("X-SBISSessionID", Подключение.ИдСессии);
	КонецЕсли;

	ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	ОтветHTTP = Подключение.Соединение.ОтправитьДляОбработки(ЗапросHTTP);
	ТекстОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстОтвета);
	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение СтрШаблон(НСтр("ru = 'СБИС вернул некорректный ответ на %1 (код %2).'"), ИмяМетода, ОтветHTTP.КодСостояния);
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Новый Структура("Результат, Ошибка", Данные.Получить("result"), Данные.Получить("error"));

КонецФункции

&НаСервере
Функция ТекстОшибкиСБИС(Ошибка)

	Если ТипЗнч(Ошибка) <> Тип("Соответствие") Тогда
		Возврат Строка(Ошибка);
	КонецЕсли;

	Подробно = Ошибка.Получить("details");
	Возврат ?(ЗначениеЗаполнено(Подробно), Подробно, Строка(Ошибка.Получить("message")));

КонецФункции

// Формат СБИС: дд.ММ.гггг или дд.ММ.гггг Ч:мм:сс
&НаСервере
Функция ДатаИзСтроки(Значение)

	Текст = СокрЛП(Значение);
	Если СтрДлина(Текст) < 10 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Сред(Текст, 7, 4)), Число(Сред(Текст, 4, 2)), Число(Лев(Текст, 2)));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

&НаСервере
Функция ДатаВремяИзСтроки(Значение)

	Текст = СокрЛП(Значение);
	Результат = ДатаИзСтроки(Текст);
	Если СтрДлина(Текст) <= 10 ИЛИ НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Части = СтрРазделить(СтрЗаменить(Сред(Текст, 12), ".", ":"), ":", Ложь);
	Попытка
		Возврат Результат + Число(Части[0]) * 3600 + Число(Части[1]) * 60 + Число(Части[2]);
	Исключение
		Возврат Результат;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ЧислоИзСтроки(Значение)

	Попытка
		Возврат Число(СтрЗаменить(СокрЛП(Значение), ",", "."));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

