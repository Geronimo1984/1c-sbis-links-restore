#Область ПрограммныйИнтерфейс

// Сведения для подключения в «Дополнительные отчеты и обработки».
//
// Возвращаемое значение:
//  Структура - регистрационные данные обработки.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", ТипСтрока);
	Команды.Колонки.Добавить("Идентификатор", ТипСтрока);
	Команды.Колонки.Добавить("Использование", ТипСтрока);
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", ТипСтрока);

	Команда = Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Восстановление связей с пакетами СБИС'");
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = "ОткрытиеФормы";

	РегистрационныеДанные = Новый Структура;
	РегистрационныеДанные.Вставить("Вид", "ДополнительнаяОбработка");
	РегистрационныеДанные.Вставить("Назначение", Неопределено);
	РегистрационныеДанные.Вставить("Наименование", НСтр("ru = 'Восстановление связей документов 1С с пакетами СБИС'"));
	РегистрационныеДанные.Вставить("Версия", "1.1");
	РегистрационныеДанные.Вставить("БезопасныйРежим", Ложь);
	РегистрационныеДанные.Вставить("Информация", НСтр("ru = 'Подбор документов 1С к пакетам СБИС и восстановление удаленных дополнительных сведений.'"));
	РегистрационныеДанные.Вставить("Команды", Команды);

	Возврат РегистрационныеДанные;

КонецФункции

#КонецОбласти
